+TEST_CASE("concurrent flush waits for each caller", "[async]") {
+    constexpr size_t n_threads = 8;
+    constexpr size_t messages = 5;
+    auto tp = std::make_shared<spdlog::details::thread_pool>(128, 1);
+    std::atomic<size_t> incomplete{0};
+    std::vector<std::thread> threads;
+
+    for (size_t i = 0; i < n_threads; ++i) {
+        threads.emplace_back([&, i] {
+            auto sink = std::make_shared<spdlog::sinks::test_sink_mt>();
+            sink->set_delay(std::chrono::milliseconds(2));
+            auto logger = std::make_shared<spdlog::async_logger>(
+                std::to_string(i), sink, tp, spdlog::async_overflow_policy::block);
+            for (size_t j = 0; j < messages; ++j) {
+                logger->info("message");
+            }
+            logger->flush();
+            if (sink->msg_counter() != messages || sink->flush_counter() != 1) {
+                ++incomplete;
+            }
+        });
+    }
+
+    for (auto &thread : threads) {
+        thread.join();
+    }
+    REQUIRE(incomplete == 0);
+}
+
 TEST_CASE("async periodic flush", "[async]") {
