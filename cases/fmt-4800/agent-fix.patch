diff --git a/include/fmt/base.h b/include/fmt/base.h
index 20cccc2..a8de877 100644
--- a/include/fmt/base.h
+++ b/include/fmt/base.h
@@ -2593,7 +2593,7 @@ template <typename Context> class basic_format_args {
   FMT_CONSTEXPR auto get(int id) const -> format_arg {
     auto arg = format_arg();
     if (!is_packed()) {
-      if (id < max_size()) arg = args_[id];
+      if (id >= 0 && id < max_size()) arg = args_[id];
       return arg;
     }
     if (unsigned(id) >= detail::max_packed_args) return arg;
diff --git a/test/printf-test.cc b/test/printf-test.cc
