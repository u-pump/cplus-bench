+TEST(memory_buffer_test, move_assignment_nonpropagating_allocator) {
+  using buffer = basic_memory_buffer<char, 4, allocator_ref<mock_allocator<char>>>;
+  StrictMock<mock_allocator<char>> source_alloc, target_alloc;
+  char source_mem[6], old_target_mem[6], new_target_mem[6];
+  EXPECT_CALL(source_alloc, allocate(6)).WillOnce(Return(source_mem));
+  EXPECT_CALL(target_alloc, allocate(6))
+      .WillOnce(Return(old_target_mem))
+      .WillOnce(Return(new_target_mem));
+  EXPECT_CALL(target_alloc, deallocate(old_target_mem, 6));
+  EXPECT_CALL(target_alloc, deallocate(new_target_mem, 6));
+  EXPECT_CALL(source_alloc, deallocate(source_mem, 6));
+  {
+    buffer source((allocator_ref<mock_allocator<char>>(&source_alloc)));
+    buffer target((allocator_ref<mock_allocator<char>>(&target_alloc)));
+    source.append("source", "source" + 6);
+    target.append("target", "target" + 6);
+    target = std::move(source);
+    EXPECT_EQ(&target_alloc, target.get_allocator().get());
+    EXPECT_EQ("source", std::string(target.data(), target.size()));
+    EXPECT_EQ("source", std::string(source.data(), source.size()));
+    EXPECT_EQ(new_target_mem, target.data());
+  }
+}
